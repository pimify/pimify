# --- Core ---
SECRET_KEY=change-me-to-a-strong-secret
MODE=development

# --- Deployment (production) ---
# Full URL with scheme, e.g. https://pimify.example.com
DOMAIN=http://127.0.0.1:8000

# --- Integrations ---
# Get your App ID from https://openexchangerates.org/ (optional; empty disables exchange jobs)
OPEN_EXCHANGE_RATES_APP_ID=

# --- Database (optional for now; SQLite/WAL is default) ---
# DATABASE_URL=sqlite:///data/db.sqlite3

# --- Backups ---
DBBACKUP_CLEANUP_KEEP=3
DBBACKUP_CLEANUP_KEEP_MEDIA=3
