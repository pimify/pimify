# --- Core ---
SECRET_KEY=change-me-to-a-strong-secret
MODE=development

# --- Deployment (production) ---
# Full URL with scheme, e.g. https://pimify.example.com
DOMAIN=http://127.0.0.1:8000

# --- Database (optional for now; SQLite/WAL is default) ---
# DATABASE_URL=sqlite:///data/db.sqlite3

# --- Media uploads (product images) ---
# Local media/ dir by default. MEDIA_S3_BUCKET switches uploads to S3/MinIO
# (unsigned URLs: marketplace crawlers fetch asynchronously, so signed URLs
# would 403 — the bucket/prefix must be publicly readable, or put a CDN in
# front via MEDIA_S3_CUSTOM_DOMAIN). MEDIA_BASE_URL instead prefixes local
# files with your own origin when nginx/CDN serves /media/ for you.
# Credentials come from the standard AWS env chain, never from this file:
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY=
# NOTE: uncomment a line by deleting ONLY the leading '#'. Whatever follows
# the '=' is the literal value — trailing '# ...' notes are NOT stripped by
# decouple and would corrupt the setting.
# MEDIA_S3_BUCKET=
# MEDIA_S3_PREFIX=media/
# MEDIA_S3_REGION=us-east-1
# Endpoint for MinIO / S3-compatible APIs (leave commented for real AWS):
# MEDIA_S3_ENDPOINT_URL=
# Optional CDN origin, e.g. cdn.example.com:
# MEDIA_S3_CUSTOM_DOMAIN=
# Set true to add ACL public-read on upload:
# MEDIA_S3_PUBLIC_READ=false
# Self-served /media/ origin, e.g. https://pimify.example.com:
# MEDIA_BASE_URL=

# --- Backups ---
DBBACKUP_CLEANUP_KEEP=3
DBBACKUP_CLEANUP_KEEP_MEDIA=3
# Optional S3 off-site backups (local backups/ dir when unset).
# Credentials come from the standard AWS env chain, never from this file:
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY=
# DBBACKUP_S3_BUCKET=
# DBBACKUP_S3_PREFIX=pimify/
# DBBACKUP_S3_REGION=us-east-1
# Endpoint for MinIO / S3-compatible APIs (leave commented for real AWS):
# DBBACKUP_S3_ENDPOINT_URL=
