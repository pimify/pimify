# --- Core ---
SECRET_KEY=change-me-to-a-strong-secret
MODE=development

# --- Deployment (production) ---
# Full URL with scheme, e.g. https://pimify.example.com
DOMAIN=http://127.0.0.1:8000

# --- Database (optional for now; SQLite/WAL is default) ---
# DATABASE_URL=sqlite:///data/db.sqlite3

# --- Backups ---
DBBACKUP_CLEANUP_KEEP=3
DBBACKUP_CLEANUP_KEEP_MEDIA=3
# Optional S3 off-site backups (local backups/ dir when unset).
# Credentials come from the standard AWS env chain, never from this file:
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY=
# DBBACKUP_S3_BUCKET=
# DBBACKUP_S3_PREFIX=pimify/
# DBBACKUP_S3_REGION=us-east-1
# DBBACKUP_S3_ENDPOINT_URL=  # set for MinIO / S3-compatible APIs
