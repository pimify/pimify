# Pimify development env (copied to .env.dev by install.sh / install.bat).
# MODE is read from the real OS environment, never from this file — but it
# is listed here so the mapping is obvious: MODE=development reads .env.dev.
# Dev needs nothing secret: development.py uses a hardcoded dummy key.
MODE=development

# Full URL with scheme (dev default; override if you serve on another host).
DOMAIN=http://127.0.0.1:8000

# Optional extras, same shapes as production (all commented = local defaults):
# MEDIA_BASE_URL=
# DBBACKUP_CLEANUP_KEEP=3
# DBBACKUP_CLEANUP_KEEP_MEDIA=3
