# VCS, environment, local tooling
.git
.gitignore
# .env* (not .env): real per-env files are .env.dev / .env.prod and MUST
# never bake into an image — a prod host that builds here would leak its
# live SECRET_KEY into a layer. Negations re-include the examples only
# (order matters: later lines win). .env kept for the legacy filename.
.env
.env*
!.env.dev.example
!.env.prod.example
.venv
env

# Local runtime data & artifacts — never belongs in an image
data
backups
media
static
feeds

# Python bytecode — blanket rule (a per-path list always misses new apps)
**/__pycache__/
*.pyc

# Personal local work log (untracked; keep it out of the image)
TODO.md

# Host-side installers, not needed in the OCI image
script/start/install.sh
script/start/install.bat
